{
  "name": "@shellicar/ui-shadcn",
  "private": false,
  "version": "1.0.3",
  "type": "module",
  "license": "MIT",
  "author": "Stephen Hellicar",
  "description": "Svelte 5 UI component library built on shadcn-svelte and Tailwind CSS",
  "keywords": [
    "svelte",
    "shadcn",
    "ui",
    "components",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellicar/ui-shadcn.git"
  },
  "bugs": {
    "url": "https://github.com/shellicar/ui-shadcn/issues"
  },
  "homepage": "https://github.com/shellicar/ui-shadcn#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "style": "./dist/app.css"
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/app.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "*.md"
  ],
  "scripts": {
    "demo": "vite dev",
    "build": "vite build && npm run prepack",
    "dev": "svelte-kit sync && svelte-package --watch",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "peerDependencies": {
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/typography": "^0.5.0",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.11.0",
    "@lucide/svelte": "^0.575.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.53.4",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "bits-ui": "^2.16.2",
    "clsx": "^2.1.1",
    "formsnap": "^2.0.1",
    "publint": "^0.3.17",
    "svelte": "^5.53.6",
    "svelte-check": "^4.4.4",
    "sveltekit-superforms": "^2.30.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
