{
  "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/.svelte-kit", "!**/dist/**/*", "!**/vite.config.ts.timestamp-*", "!**/build", "!packages/ui-shadcn/src/lib/components/ui", "!packages/ui-shadcn/src/lib/utils.ts"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 300,
    "indentWidth": 2,
    "lineEnding": "lf",
    "attributePosition": "auto"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "info"
      },
      "correctness": {
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "off"
      },
      "style": {
        "useImportType": "error",
        "useBlockStatements": "error",
        "noNonNullAssertion": "info"
      },
      "performance": {
        "noBarrelFile": "error"
      }
    }
  },
  "graphql": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": true,
      "trailingCommas": "all",
      "quoteProperties": "asNeeded",
      "lineWidth": 300,
      "attributePosition": "auto"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedImports": "off"
          },
          "suspicious": {
            "noImplicitAnyLet": "off",
            "noConsole": {
              "level": "warn",
              "options": {
                "allow": ["error"]
              }
            }
          }
        }
      }
    }
  ]
}
